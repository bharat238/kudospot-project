# ==============================================================================
# KUDOSPOT ENVIRONMENT VARIABLES REFERENCE
# ==============================================================================
# This file serves as a reference for setting up local development and production.
# Copy this file to '.env' for local development:
#   cp .env.example .env
#
# DO NOT commit your actual secret keys to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Vite + Cloudflare Pages)
# ------------------------------------------------------------------------------
# These must be set in:
#   - Local: '.env' file
#   - Cloudflare Pages Dashboard: Settings -> Environment Variables
#     (Make sure to set these for BOTH Production and Preview environments)
# ------------------------------------------------------------------------------

# The API URL of your Supabase project (from Supabase Dashboard -> Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# The Anon/Public Key of your Supabase project (from Supabase Dashboard -> Settings -> API)
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# The project reference ID of your Supabase project (e.g. from the URL of your dashboard)
VITE_SUPABASE_PROJECT_ID=your-supabase-project-reference-id

# Node version requirement for Cloudflare build environments (recommended: 18 or higher)
NODE_VERSION=18


# ------------------------------------------------------------------------------
# 2. SUPABASE EDGE FUNCTIONS SECRETS (Do NOT put these in Cloudflare)
# ------------------------------------------------------------------------------
# These secrets must be added to your Supabase Edge Functions environment.
# You can add them via the Supabase Dashboard -> Edge Functions -> Secrets,
# or via the Supabase CLI:
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
# ------------------------------------------------------------------------------

# Required to power AI testimonial rewrite, case study generator, and social post generator
# Get this key from platform.anthropic.com -> API Keys -> Create Key
# Secret Name: ANTHROPIC_API_KEY
# Value format: sk-ant-...
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# Required for sending automated approval emails to customers.
# Get this key from resend.com -> API Keys -> Create API Key
# Secret Name: RESEND_API_KEY
# Value format: re_...
# RESEND_API_KEY=re_your-key-here

# Required for plan upgrades and subscription billing.
# Get these keys from dashboard.razorpay.com -> Settings -> API Keys
# Secret Names: RAZORPAY_KEY_ID, RAZORPAY_KEY_SECRET
# Value format: rzp_test_... or rzp_live_...
# RAZORPAY_KEY_ID=rzp_test_your-key-id
# RAZORPAY_KEY_SECRET=your-razorpay-secret-key

# The URL of your frontend site. Used to construct approval/embed links in emails.
# In local development: http://localhost:5173
# In production: https://kudospot.io or https://your-app.pages.dev
# Secret Name: SITE_URL
# SITE_URL=https://kudospot.io
